    {
      "id": "f1a2b3c4-d5e6-4708-9192-a3b4c5d6e7f9",
      "name": "Render confirmation email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2640,
        -224
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const TEMPLATE = `Subject: We've got your form for {{ collective_name }}\n\nHi,\n\nYour application form for {{ collective_name }} has arrived. A human will now go through\nit — that usually takes a couple of weeks.\n\nNo action needed from you for now. We'll email you as soon as there's a decision. If you\nneed to add or change anything in the meantime, reply to this email.\n\n— {{ org_name }}`;\nconst ORG_NAMES = { OSE: 'Open Source Europe' };\nconst row = $json; // the updated row returned by Record submission\nconst recipient = row.contact_email;\nif (!recipient) throw new Error(`form confirmation: no contact email for ${row.slug}`);\nconst vars = { collective_name: row.collective_name, org_name: ORG_NAMES[row.org] || row.org };\nconst render = (tpl) => tpl.replace(/\\{\\{\\s*(\\w+)\\s*\\}\\}/g, (m, key) => {\n  const value = vars[key];\n  if (value === undefined || value === null || value === '') {\n    throw new Error(`form confirmation: missing \"${key}\" for ${row.slug}`);\n  }\n  return String(value);\n});\nconst cut = TEMPLATE.indexOf('\\n');\nlet subject = render(TEMPLATE.slice('Subject: '.length, cut));\nconst body = render(TEMPLATE.slice(cut).trimStart());\nconst suppressed = ($env.DRY_RUN || '').toLowerCase() === 'true';\nif (suppressed) subject = `[DRY_RUN → would have gone to ${recipient}] ${subject}`;\nconst to = suppressed ? ($env.DRY_RUN_RECIPIENT || '') : recipient;\nif (!to) throw new Error('form confirmation: DRY_RUN is true but DRY_RUN_RECIPIENT is empty');\nreturn { json: { slug: row.slug, to, subject, body, suppressed } };"
      },
      "notes": "DRY_RUN is checked here, at the send site. Template embedded verbatim from automation/emails/form-received.md."
    },
    {
      "id": "f2b3c4d5-e6f7-4819-9293-b4c5d6e7f902",
      "name": "Send confirmation email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        2864,
        -224
      ],
      "parameters": {
        "fromEmail": "={{ $env.SMTP_FROM }}",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.body }}",
        "options": {
          "appendAttribution": false
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "webhookId": "d937445e-5003-4c8a-8fa9-2d2e9f76a657",
      "credentials": {
        "smtp": {
