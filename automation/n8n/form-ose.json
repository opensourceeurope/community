        }
      }
    },
    {
      "id": "f3c4d5e6-f7a8-492a-93a4-c5d6e7f90a13",
      "name": "Render Slack notification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3088,
        -224
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const TEMPLATE = ':inbox_tray: *{{ collective_name }}* ({{ slug }}, applied to {{ org_name }}) submitted the application form and is ready for evaluation. {{ collective_url }}';\nconst ORG_NAMES = { OSE: 'Open Source Europe' };\nconst row = $('Record submission').item.json;\nconst vars = {\n  collective_name: row.collective_name,\n  slug: row.slug,\n  org_name: ORG_NAMES[row.org] || row.org,\n  collective_url: row.collective_url,\n};\nconst render = (tpl) => tpl.replace(/\\{\\{\\s*(\\w+)\\s*\\}\\}/g, (m, key) => {\n  const value = vars[key];\n  if (value === undefined || value === null || value === '') {\n    throw new Error(`slack notification: missing \"${key}\" for ${row.slug}`);\n  }\n  return String(value);\n});\nconst body = render(TEMPLATE);\nconst channel = $env.SLACK_CHANNEL || '';\nconst suppressed = ($env.DRY_RUN || '').toLowerCase() === 'true';\nconst to = suppressed ? ($env.DRY_RUN_RECIPIENT || '') : channel;\nif (!to) throw new Error(suppressed ? 'slack notification: DRY_RUN is true but DRY_RUN_RECIPIENT is empty' : 'slack notification: SLACK_CHANNEL is empty');\nconst subject = `[DRY_RUN → would have gone to Slack ${channel || '(no channel set)'}] Form submitted by ${row.slug}`;\nreturn { json: { slug: row.slug, to, subject, body, suppressed } };"
      },
      "notes": "Ready for evaluation. DRY_RUN is checked here: a suppressed notification goes to DRY_RUN_RECIPIENT by email instead of to Slack."
    },
    {
      "id": "f4d5e6f7-a8b9-4a3b-94b5-d6e7f90a1b24",
      "name": "Notification suppressed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        3312,
        -224
      ],
      "parameters": {
