[Unit]
Description=Back up the n8n Postgres database (workflows, credentials, applicant state)
Documentation=https://github.com/opensourceeurope/community/blob/main/automation/infra/README.md
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
OnFailure=ose-alert@%n.service

[Service]
Type=oneshot
User=debian
# backup.sh appends to ~/backups/backup.log itself. No StandardOutput=append:
# here, because that replaces the journal and the failure alert reads the
# journal.
ExecStart=/home/debian/community/automation/infra/backup.sh
ExecStartPost=-/home/debian/community/automation/infra/alert-slack.sh --recovered %n
