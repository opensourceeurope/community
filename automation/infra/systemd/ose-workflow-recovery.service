[Unit]
Description=Post to Slack when a workflow that failed runs successfully again
Documentation=https://github.com/opensourceeurope/community/blob/main/automation/infra/README.md
After=docker.service network-online.target
Wants=network-online.target
# The failure alert workflow posts when a run fails. This posts the all-clear
# once a later run of the same workflow succeeds. The check exits non-zero
# only when it cannot read the executions or post, which fails this unit and
# posts that to the alerts channel, once.
OnFailure=ose-alert@%n.service

[Service]
Type=oneshot
User=debian
ExecStart=/usr/bin/python3 /home/debian/community/automation/infra/check-workflow-recovery.py /home/debian/community
# Posts that the check itself works again, and only after it did not.
ExecStartPost=-/home/debian/community/automation/infra/alert-slack.sh --recovered %n
