[Unit]
Description=Deploy origin/main on this box: infra changes, then the n8n workflow exports
Documentation=https://github.com/opensourceeurope/community/blob/main/automation/infra/README.md
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
OnFailure=ose-alert@%n.service

[Service]
Type=oneshot
User=debian
ExecStart=/home/debian/community/automation/infra/deploy.sh
# The leading `-` keeps a Slack outage from turning a good deploy into a
# failed one, which would then alert about a failure that never happened.
ExecStartPost=-/home/debian/community/automation/infra/alert-slack.sh --recovered %n
