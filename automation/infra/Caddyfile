# automation/infra/Caddyfile
#
# Two names, one n8n container.
#
# APPLY_HOST is applicant-facing: the bare URL is the OSE application form, so
# the link in a step-2 email is https://apply.opensourceeurope.org and nothing
# more. n8n itself serves forms at /form/<path> and keeps the editor at /, so
# the bare-URL form is this rewrite, not an n8n feature.
#
# N8N_HOST is the admin surface — the editor, and the Open Collective webhook
# endpoint. Deliberately not named after n8n: every hostname issued a
# certificate appears in public Certificate Transparency logs, and there is no
# reason to advertise which software is behind it.
#
# Neither name hands n8n the whole internet. The database behind the editor
# holds every applicant's email address, and n8n's login page is a target for
# every n8n advisory that needs no account. So APPLY_HOST answers only the
# paths an applicant's browser uses, and N8N_HOST puts everything a person
# uses, the editor and its login page included, behind a second password that
# Caddy checks before n8n sees the request. A bug in n8n's own login then
# cannot be reached from the internet. The password lives in the vault only.
# Its bcrypt hash is in editor-auth.caddy next to this file, in git, which is
# safe for a long random password: a hash checks a password, it cannot be
# turned back into one.

{$APPLY_HOST} {
	encode zstd gzip

	# The link preview image. n8n hardcodes
	# <meta property="og:image" content="/static/og_image.png"> into its form
	# template, with no node parameter and no environment variable behind it,
	# and the file it points at is n8n's own brand card. Serving that one path
	# from here puts the OSE logo in the preview instead. The form page loads
	# no other /static/ asset, so Caddy intercepts nothing else n8n serves.
	handle /static/og_image.png {
		root * /srv/public
		file_server
	}

	# What the form uses, and nothing else. The page is one HTML document with
	# its script inline. It posts back to its own URL, and every later page
	# lives under /form-waiting/, which n8n signs.
	@form path / /form/* /form-waiting/*
	handle @form {
		# Only the bare path is rewritten. Page-to-page posts keep their own
		# paths, so a multi-page form stays on this hostname.
		rewrite / /form/apply-ose

		reverse_proxy n8n:5678
	}

	# The editor, its login page, the REST and public APIs and the webhooks
	# all used to answer here too. None of them is for applicants.
	handle {
		respond 404
	}
}

{$N8N_HOST} {
	encode zstd gzip

	# Public, because a machine calls each without a person to type a password:
	# Open Collective's webhook, the form's later pages when n8n links them
	# here, the public API the deploy and the operator's tools use with an API
	# key, and the health check the deploy waits on.
	@machine path /webhook/* /form/* /form-waiting/* /api/v1/* /healthz
	handle @machine {
		reverse_proxy n8n:5678
	}

	# Everything a person uses: the editor, /signin, /rest and the test
	# webhooks. A browser asks for this password once and sends it with every
	# request after, the editor's own calls included.
	handle {
		import editor-auth.caddy
		reverse_proxy n8n:5678
	}
}
