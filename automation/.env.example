# Configuration for the OSE application automation (issue #13).
#
# Copy to .env and fill in. NEVER commit a filled-in copy — this file documents
# the APPLICATION variables, not values.
#
# Not in here, deliberately: the infra-only variables the compose file also
# needs (N8N_HOST, APPLY_HOST, POSTGRES_PASSWORD, N8N_ENCRYPTION_KEY,
# EXECUTIONS_DATA_*), which are documented in automation/infra/README.md and go
# into the same .env. Nor SMTP, Slack and Open Collective credentials. Those live in n8n's
# own credential store, referenced by name from the nodes, so they are never in
# a file and never in git.

# ---------------------------------------------------------------------------
# Outbound safety
# ---------------------------------------------------------------------------

# Gates applicant-facing email, and nothing else. Every email send site checks
# it in the render step right before its email node.
#   true  = suppressed: the email goes to DRY_RUN_RECIPIENT, prefixed with who
#           it would have reached. State still advances, and the row is marked
#           dry_run so it is visibly a test.
#   false = normal delivery to applicants.
#
# Slack is never gated by this. The thread is the reviewers' own log, internal
# to the team, so every Slack message and reaction posts to SLACK_CHANNEL for
# real, including during a rehearsal with DRY_RUN=true.
DRY_RUN=true

# Where suppressed applicant emails go while DRY_RUN=true. It must be set then:
# an email render node throws rather than send a suppressed message to nobody.
DRY_RUN_RECIPIENT=

# ---------------------------------------------------------------------------
# Timing
# ---------------------------------------------------------------------------
# Integer minutes, not "7d" strings, so an n8n expression can compare them
# directly without a duration parser.

# Silence after the step-2 email before the applicant gets a reminder.
# Production: 10080 (7 days). Testing: 5.
REMINDER_AFTER_MINUTES=10080

# Further silence after the reminder before Slack asks a human to decide.
# Also applies to an application advised it looks like the wrong host.
# Production: 10080 (7 days). Testing: 5.
ESCALATE_AFTER_MINUTES=10080

# How often the sweep evaluates the thresholds above and picks up any
# application the webhooks missed.
# Production: 0 6 * * * (daily). Testing: */2 * * * *
#
# Shortening the thresholds alone does nothing: they are only evaluated when
# the sweep runs, so a 5-minute threshold on a daily sweep still takes a day
# to fire. Shorten this with them — or just click Execute on the sweep
# workflow in the n8n UI, which is faster for a single test.
SWEEP_CRON=0 6 * * *

# Comma-separated collective slugs. Empty in production: the sweep processes
# every application.
#
# This is a SAFETY control, not a convenience. The automation runs against
# production Open Collective data, so a sweep with shortened thresholds would
# otherwise process every genuinely pending application at once — dozens of
# dry-run messages about real applicants, and real state rows advanced by a
# test. Set this to your test collectives before shortening any timing.
ONLY_SLUGS=

# ---------------------------------------------------------------------------
# Application forms
# ---------------------------------------------------------------------------

# The step-2 form link sent to an applicant. Static configuration, not
# per-application state: the form's first page asks the applicant for their
# Open Collective collective URL, and the slug derived from it is what matches
# a submission back to its row. So there is no per-application token and no
# column holding a link.
# The form is served at the bare hostname (Caddy rewrites / to the form
# path) — see automation/infra/README.md, "Two hostnames".
FORM_URL_OSE=https://apply.opensourceeurope.org

# ---------------------------------------------------------------------------
# Outbound identities
# ---------------------------------------------------------------------------
# The From address on every applicant email, e.g.
#   Open Source Europe <applications@opensourceeurope.org>
# It must be an address the SMTP relay is authorised to send as — the domain's
# SPF forbids sending from the VPS directly (see automation/infra/README.md).
# With Proton as the relay, the address must be the one the SMTP token was
# generated for. A Proton token sends as its own address only.
# The SMTP credential itself lives in n8n's credential store, not here.
SMTP_FROM=

# The channel every application's thread lives in, e.g. #applications. Intake
# posts one parent message per application here and every later stage replies
# in its thread and reacts on the parent, so a reviewer follows an application
# in one place. The intake render node throws when this is empty, so no row is
# ever created without a thread to report into. The Slack credential lives in
# n8n's credential store, not here.
SLACK_CHANNEL=

# ---------------------------------------------------------------------------
# AI review — inference provider (Scaleway Generative APIs, EU)
# ---------------------------------------------------------------------------
# Scaleway was chosen because it is EU-hosted and already proven to work for this
# model at negligible cost. The endpoint is OpenAI-compatible, so the provider
# stays swappable — Mistral's own API or a local Ollama work with the same code.
# This project owns these variable names; nothing here is coupled to any other
# repository.
#
# The review is ADVISORY. It never approves, rejects or closes an application
# — that stays a human decision made on Open Collective, per the org AI policy:
# https://github.com/opensourceeurope/.github/blob/main/AI-POLICY.md
#
# Only public project material is sent: description, application message, and
# linked repository and website. Never an applicant's name or email address.

# Scaleway IAM API keys come as a pair. The inference endpoint authenticates with
# the SECRET key as a bearer token — the access key is for other Scaleway APIs
# and the CLI, and is not needed here.
#
# Use a key dedicated to this automation, not one already in use elsewhere:
# separate keys rotate independently and limit the blast radius of a leak.
AI_API_KEY=
AI_MODEL=mistral-small-3.2-24b-instruct-2506
# OpenAI-compatible base URL. The /v1 path is appended, so do not include it.
# Leaving this unset does NOT mean "no provider" — the harness and the workflow
# both fall back to Scaleway, so an unset value with no key just fails at the
# call. Set it explicitly to whatever you are using:
#   Scaleway (EU):  https://api.scaleway.ai
#   Mistral's API:  https://api.mistral.ai
#   local Ollama:   http://localhost:11434  (with AI_API_KEY=ollama)
AI_BASE_URL=https://api.scaleway.ai
